# slack or discord. Discord also needs: docker compose --profile discord up -d
ALERT_RECEIVER=slack

# Incoming webhook. Leave empty to keep alerts in the Alertmanager UI only.
ALERT_WEBHOOK_URL=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Chance each demo run fails, from 0 to 1.
DEMO_FAIL_RATE=0.25

# Set to 25 to freeze the last success 25 hours in the past and fire DataStale.
DEMO_STALE_HOURS=0

# Seconds between the end of one run and the start of the next, before a slow run.
DEMO_INTERVAL_SECONDS=15
